modules = ["nodejs-20", "php-8.2", "web", "python-base-3.13", "php-8.4"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Laundry Admin"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Laundry Customer App"

[[workflows.workflow]]
name = "Laundry Admin"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Laundry-AdminPanel-SourceCode/install/install && env -u DATABASE_URL php -d display_errors=0 artisan serve --host=0.0.0.0 --port=5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Laundry Customer App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Best-Laundry-Customer-App-SDK-3.41.6/build/web && python3 -m http.server 5001 --bind 0.0.0.0"
waitForPort = 5001

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
